{
  "version": "0.0.0",
  "commands": {
    "dev:git:open-linear-branch": {
      "id": "dev:git:open-linear-branch",
      "description": "Opens a linear ticket for the current branch",
      "strict": true,
      "pluginName": "rk",
      "pluginAlias": "rk",
      "pluginType": "core",
      "aliases": [],
      "flags": {
        "token": { "name": "token", "type": "option", "required": true, "multiple": false },
        "baseUrl": { "name": "baseUrl", "type": "option", "required": true, "multiple": false }
      },
      "args": [],
      "_globalFlags": {}
    },
    "dev:git:pr": {
      "id": "dev:git:pr",
      "description": "Open a pull request using GitHub API",
      "strict": true,
      "pluginName": "rk",
      "pluginAlias": "rk",
      "pluginType": "core",
      "aliases": [],
      "examples": [
        "$ rk dev:git:pr --title \"fix: [SC-1234] - Update dependencies\" --body \"Description of changes\" --base main --head feature-branch"
      ],
      "flags": {
        "title": {
          "name": "title",
          "type": "option",
          "char": "t",
          "description": "Pull request title",
          "required": false,
          "multiple": false
        },
        "body": {
          "name": "body",
          "type": "option",
          "char": "b",
          "description": "Pull request description",
          "required": false,
          "multiple": false
        },
        "type": {
          "name": "type",
          "type": "option",
          "char": "T",
          "description": "Pull request type (e.g., \"fix\", \"feat\")",
          "multiple": false,
          "options": ["fix", "feat", "chore"],
          "default": "fix"
        },
        "base": {
          "name": "base",
          "type": "option",
          "description": "Base branch",
          "multiple": false,
          "default": "master"
        },
        "githubToken": { "name": "githubToken", "type": "option", "required": false, "multiple": false }
      },
      "args": [],
      "_globalFlags": {}
    },
    "dev:git:resume-linear-branch": {
      "id": "dev:git:resume-linear-branch",
      "description": "Resumes linear branches",
      "strict": true,
      "pluginName": "rk",
      "pluginAlias": "rk",
      "pluginType": "core",
      "aliases": [],
      "flags": { "token": { "name": "token", "type": "option", "required": false, "multiple": false } },
      "args": [],
      "_globalFlags": {}
    },
    "dev:git:switch-linear-branch": {
      "id": "dev:git:switch-linear-branch",
      "description": "Switches to a branch by a shortcut name",
      "strict": true,
      "pluginName": "rk",
      "pluginAlias": "rk",
      "pluginType": "core",
      "aliases": [],
      "flags": {
        "token": { "name": "token", "type": "option", "required": false, "multiple": false },
        "username": {
          "name": "username",
          "type": "option",
          "required": true,
          "multiple": false,
          "default": "anton.kropp"
        },
        "teamKey": { "name": "teamKey", "type": "option", "required": true, "multiple": false }
      },
      "args": [],
      "_globalFlags": {}
    }
  }
}
